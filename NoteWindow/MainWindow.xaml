<Window x:Class="NoteWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoteWindow"
        xmlns:vm="clr-namespace:NoteWindow.ViewModel.Model;assembly=NoteWindow.ViewModel"
        xmlns:vmMain="clr-namespace:NoteWindow.ViewModel.ViewModel;assembly=NoteWindow.ViewModel"
        mc:Ignorable="d"
        Title="Notes" Height="450" Width="700">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
            <local:NoteView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMain:ProfileUserControlViewModel}">
            <local:ProfileUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMain:DictionaryUserControlViewModel}">
            <local:DictionaryUserControl/>
        </DataTemplate>
    </Window.Resources>
    <StackPanel Orientation="Horizontal">
        <Grid MaxWidth="100">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Command="{Binding ShowProfileCommand}" Content="Профиль"/>
            <Button Grid.Row="1" Command="{Binding ShowDictionaryCommand}" Content="Словари"/>
            <Button Grid.Row="2">Курс</Button>
            <ListBox SelectedItem="{Binding NoteViewModel.SelectedNote}" ItemsSource="{Binding NoteViewModel.Notes}" x:Name="ListNotes" MinWidth="50" Grid.Row="3">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" Cursor=""/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        
        <ContentControl Content="{Binding CurrentView}"/>
    </StackPanel>
</Window>
