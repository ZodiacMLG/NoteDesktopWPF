<Window x:Class="NoteWindow.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NoteWindow"
        xmlns:vm="clr-namespace:NoteWindow.ViewModel.Model;assembly=NoteWindow.ViewModel"
        xmlns:vmMain="clr-namespace:NoteWindow.ViewModel.ViewModel;assembly=NoteWindow.ViewModel"
        mc:Ignorable="d"
        Title="Notes" Height="450" Width="700">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
            <DockPanel LastChildFill="True">
                <local:NoteView />
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMain:ProfileUserControlViewModel}">
            <local:ProfileUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmMain:DictionaryUserControlViewModel}">
            <local:DictionaryUserControl/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель -->
        <Grid Grid.Column="0" MaxWidth="100" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Command="{Binding ShowProfileCommand}" Content="Профиль" Click="ButtonProfile_Click"/>
            <Button Grid.Row="1" Command="{Binding ShowDictionaryCommand}" Content="Карточки"/>
            <Button Grid.Row="2" Command="{Binding ShowNotesCommand}" Content="Заметки"/>
            

            <ListBox Grid.Row="3" 
                     SelectedItem="{Binding NoteViewModel.SelectedNote}" 
                     ItemsSource="{Binding NoteViewModel.Notes}" 
                     x:Name="ListNotes" 
                     MinWidth="50">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Правая область для контента -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"/>
    </Grid>
</Window>