<UserControl x:Class="NoteWindow.NoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NoteWindow"
             xmlns:vm="clr-namespace:NoteWindow.ViewModel.Model;assembly=NoteWindow.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:NoteViewModel}">
            <local:NoteView />
        </DataTemplate>
    </UserControl.Resources>
    <Grid MinWidth="600">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox AcceptsReturn="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 Grid.Row="0"
                 Grid.ColumnSpan="2"
                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Создать карточку" 
                              Command="{Binding CreateCardCommand}"
                              CommandParameter="{Binding PlacementTarget.SelectedText, 
                                        RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                </ContextMenu>
            </TextBox.ContextMenu>
        </TextBox>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
            <Button x:Name="AddButton" 
                Grid.Row="1" Grid.Column="0" 
                Width="65" Margin="0,0,5,0"
                Command="{Binding CreateNoteCommand}" Content="Новая"/>
            <Button x:Name="SaveButton" 
                Grid.Row="1" Grid.Column="1"
                Width="65" Margin="0,0,5,0"
                Command="{Binding SubmitCommand}" Content="Сохранить"/>
            <Button x:Name="DeleteButton" 
                Grid.Row="1" Grid.Column="2"
                Width="65"
                Command="{Binding DeleteCommand}" Content="Удалить"/>
        </StackPanel>
    </Grid>
</UserControl>
