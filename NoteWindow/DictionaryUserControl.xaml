<UserControl x:Class="NoteWindow.DictionaryUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NoteWindow"
             xmlns:viewCards="clr-namespace:NoteWindow.Cards"
             xmlns:vmCards="clr-namespace:NoteWindow.ViewModel.ViewModel.Cards;assembly=NoteWindow.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <Style x:Key="VerticalButton" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="200"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="15">
                            <TextBlock Text="{TemplateBinding Content}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate DataType="{x:Type vmCards:StudyCardsViewModel}">
            <viewCards:NewCardUserControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vmCards:ReviewedCardViewModel}">
            <viewCards:ReviewedCardUserControl/>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Label Grid.Row="0"
               Content="Карточки"
               HorizontalAlignment="Center"
               FontSize="30"
               Visibility="{Binding MenuVisibility}"/>
        <ContentControl Content="{Binding CurrentView}"/>
        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Visibility="{Binding MenuVisibility}">
            

            <Button Content="Изучить новые термины"
                    Command="{Binding ShowNewCardsCommand}"
                    Style="{StaticResource VerticalButton}"
                    Background="#4A90E2"
                    Margin="0,0,20,0"/>

            <Button Content="Повторить пройденный материал"
                    Command="{Binding ShowReviewedCardsCommand}"
                    Style="{StaticResource VerticalButton}"
                    Background="#50C878"/>

        </StackPanel>
    </Grid>
</UserControl>