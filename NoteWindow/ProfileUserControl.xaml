<UserControl x:Class="NoteWindow.ProfileUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:NoteWindow"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel Orientation="Vertical">
        <Label HorizontalAlignment="Center" Content="Профиль пользователя"/>
        <Image Source="{Binding Avatar}" Width="100" Height="100"/>
        <Button Command="{Binding DownloadAvatarCommand}" Content="Загрузка аватара"/>
    </StackPanel>
</UserControl>
